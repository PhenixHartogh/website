---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="description"
      content="Send a file to Nix Hartogh."
    />

    <title>Send a File to Nix Hartogh</title>

    <style>
      :root {
        font-family:
          Inter,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          Roboto,
          Helvetica,
          Arial,
          sans-serif;

        --background: #f5f5f7;

        --card: rgba(255, 255, 255, 0.82);
        --card-hover: rgba(255, 255, 255, 0.98);

        --text: #1d1d1f;
        --muted: #6e6e73;

        --border: rgba(0, 0, 0, 0.08);
        --shadow: rgba(0, 0, 0, 0.08);

        --privacy-background: rgba(255, 255, 255, 0.7);
        --privacy-icon-background: rgba(0, 122, 255, 0.1);

        --accent: #007aff;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --background: #0c0c0e;

          --card: rgba(29, 29, 31, 0.82);
          --card-hover: rgba(42, 42, 45, 0.97);

          --text: #f5f5f7;
          --muted: #a1a1a6;

          --border: rgba(255, 255, 255, 0.1);
          --shadow: rgba(0, 0, 0, 0.4);

          --privacy-background: rgba(29, 29, 31, 0.7);
          --privacy-icon-background: rgba(10, 132, 255, 0.15);

          --accent: #0a84ff;
        }
      }

      * {
        box-sizing: border-box;
      }

      html {
        min-height: 100%;
      }

      body {
        margin: 0;

        min-height: 100vh;

        display: flex;
        align-items: center;
        justify-content: center;

        padding: 48px 20px;

        background:
          radial-gradient(
            circle at 50% -10%,
            rgba(0, 113, 227, 0.14),
            transparent 40%
          ),
          var(--background);

        color: var(--text);
      }

      main {
        width: 100%;
        max-width: 680px;
      }

      /* --------------------
         HEADER
      -------------------- */

      header {
        text-align: center;
        margin-bottom: 34px;
      }

      h1 {
        margin: 0 0 14px;

        font-size: clamp(2rem, 7vw, 3.3rem);
        line-height: 1.05;

        letter-spacing: -0.045em;
      }

      .subtitle {
        margin: 0 auto;

        max-width: 500px;

        color: var(--muted);

        font-size: 1.05rem;
        line-height: 1.55;
      }

      /* --------------------
         SQUARE SERVICE ICONS
      -------------------- */

      .options {
        display: grid;

        grid-template-columns: repeat(3, 1fr);

        gap: 16px;
      }

      .option {
        aspect-ratio: 1 / 1;

        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;

        gap: 16px;

        padding: 20px;

        color: inherit;
        text-decoration: none;

        text-align: center;

        background: var(--card);

        border: 1px solid var(--border);
        border-radius: 26px;

        backdrop-filter: blur(25px);
        -webkit-backdrop-filter: blur(25px);

        box-shadow: 0 8px 30px var(--shadow);

        transition:
          transform 0.2s ease,
          background 0.2s ease,
          box-shadow 0.2s ease,
          border-color 0.2s ease;
      }

      .option:hover {
        transform: translateY(-5px) scale(1.015);

        background: var(--card-hover);

        box-shadow: 0 16px 38px var(--shadow);

        border-color: rgba(128, 128, 128, 0.18);
      }

      .option:active {
        transform: scale(0.97);
      }

      .option:focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 4px;
      }

      /* --------------------
         LOGOS
      -------------------- */

      .logo-container {
        width: 84px;
        height: 84px;

        flex-shrink: 0;

        display: flex;
        align-items: center;
        justify-content: center;

        background: white;

        border-radius: 22px;

        box-shadow:
          0 4px 16px rgba(0, 0, 0, 0.08);
      }

      .logo-container img {
        width: 52px;
        height: 52px;

        object-fit: contain;
      }

      .google .logo-container img {
        width: 48px;
        height: 48px;
      }

      .sharepoint .logo-container img {
        width: 54px;
        height: 54px;
      }

      .wetransfer .logo-container img {
        width: 56px;
        height: 56px;
      }

      /* --------------------
         SERVICE NAME
      -------------------- */

      .option-name {
        display: block;

        width: 100%;

        font-size: 1rem;
        font-weight: 650;

        line-height: 1.25;

        letter-spacing: -0.015em;
      }

      /* --------------------
         PRIVACY NOTICE
      -------------------- */

      .privacy-note {
        margin-top: 28px;

        display: flex;
        align-items: flex-start;

        gap: 15px;

        padding: 20px;

        background: var(--privacy-background);

        border: 1px solid var(--border);
        border-radius: 22px;

        backdrop-filter: blur(25px);
        -webkit-backdrop-filter: blur(25px);

        box-shadow: 0 8px 30px var(--shadow);
      }

      .privacy-icon {
        width: 42px;
        height: 42px;

        flex-shrink: 0;

        display: flex;
        align-items: center;
        justify-content: center;

        background: var(--privacy-icon-background);

        border-radius: 13px;

        color: var(--accent);

        font-size: 1.2rem;
      }

      .privacy-content {
        min-width: 0;
      }

      .privacy-content strong {
        display: block;

        margin-bottom: 5px;

        font-size: 0.98rem;
        font-weight: 650;
      }

      .privacy-content p {
        margin: 0;

        color: var(--muted);

        font-size: 0.88rem;
        line-height: 1.55;
      }

      .privacy-content a {
        color: var(--accent);

        font-weight: 600;
        text-decoration: none;
      }

      .privacy-content a:hover {
        text-decoration: underline;
      }

      /* --------------------
         FOOTER
      -------------------- */

      .notice {
        margin: 24px 0 0;

        text-align: center;

        color: var(--muted);

        font-size: 0.82rem;
        line-height: 1.5;
      }

      /* --------------------
         TABLET / MOBILE
      -------------------- */

      @media (max-width: 620px) {
        body {
          padding: 32px 16px;
        }

        header {
          margin-bottom: 28px;
        }

        .options {
          grid-template-columns: repeat(2, 1fr);

          gap: 13px;
        }

        .option {
          border-radius: 22px;

          padding: 16px;

          gap: 13px;
        }

        .logo-container {
          width: 72px;
          height: 72px;

          border-radius: 19px;
        }

        .logo-container img {
          width: 44px;
          height: 44px;
        }

        .google .logo-container img {
          width: 42px;
          height: 42px;
        }

        .sharepoint .logo-container img {
          width: 46px;
          height: 46px;
        }

        .wetransfer .logo-container img {
          width: 48px;
          height: 48px;
        }

        .option-name {
          font-size: 0.94rem;
        }
      }

      @media (max-width: 360px) {
        .options {
          gap: 10px;
        }

        .option {
          padding: 12px;
        }

        .logo-container {
          width: 62px;
          height: 62px;

          border-radius: 17px;
        }

        .logo-container img {
          width: 38px;
          height: 38px;
        }

        .option-name {
          font-size: 0.88rem;
        }

        .privacy-note {
          padding: 16px;
        }
      }
    </style>
  </head>

  <body>
    <main>
      <header>
        <h1>Send a File to Nix Hartogh</h1>

        <p class="subtitle">
          Choose a service below to send me your file.
        </p>
      </header>

      <div class="options">
        {
          uploadOptions.map((option) => (
            <a
              class={`option ${option.className}`}
              href={option.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Send a file using ${option.name}`}
            >
              <div class="logo-container">
                <img
                  src={option.logo}
                  alt=""
                  loading="eager"
                />
              </div>

              <span class="option-name">
                {option.name}
              </span>
            </a>
          ))
        }
      </div>

      <div class="privacy-note">
        <div
          class="privacy-icon"
          aria-hidden="true"
        >
          🔒
        </div>

        <div class="privacy-content">
          <strong>Sending something private?</strong>

          <p>
            These upload services are operated by third parties.
            If you want the contents of your file to remain private
            between you and me, encrypt the file with my
            <a
              href="https://nixie.online/pgp"
              target="_blank"
              rel="noopener noreferrer"
            >
              PGP public key
            </a>
            before uploading it. This means the upload provider receives
            the encrypted file rather than the readable contents.
          </p>
        </div>
      </div>

      <p class="notice">
        Choose whichever service works best for you.
        You only need to upload the file once.
      </p>
    </main>
  </body>
</html>
