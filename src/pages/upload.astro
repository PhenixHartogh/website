  {
    name: "WeTransfer",
    url: "https://we.tl/r-FZfwk9GSphyYNpqJ",
    logo: "https://images.seeklogo.com/logo-png/31/2/wetransfer-logo-png_seeklogo-317882.png",
    className: "wetransfer",
  },
  {
    name: "Nextcloud",
    url: "https://aio.nixie.online/index.php/s/QG4qwipkgAYfxj2",
    logo: "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcR6Alcd3Sx0f8CrwrZh_As5TOSZvz-cfKUtn6P0va4iC4ONznBQx7HxnRnh&s=10",
    className: "nextcloud",
  },
  {
    name: "MEGA",
    url: "https://mega.nz/filerequest/jawd3rmaMHE",
    logo: "https://mega.io/wp-content/uploads/logo-mega.png",
    className: "mega",
  },
  {
    name: "Dropbox",
    url: "https://www.dropbox.com/request/8yqjjwdxefop9irj2fai",
    logo: "https://cdn.simpleicons.org/dropbox/0061FF",
    className: "dropbox",
  },
  {
    name: "Google",
    url: "https://forms.gle/v6W7co2ZcEgZpv376",
    logo: "https://thumb.wikimedia.org/wikipedia/commons/thumb/1/12/Google_Drive_icon_%282020%29.svg/960px-Google_Drive_icon_%282020%29.svg.png",
    className: "google",
  },
  {
