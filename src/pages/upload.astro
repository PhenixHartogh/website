---
const uploadOptions = [
  {
    name: "Dropbox",
    description: "Upload your file using Dropbox.",
    url: "https://www.dropbox.com/request/8yqjjwdxefop9irj2fai",
    logo: "https://cdn.simpleicons.org/dropbox/0061FF",
    className: "dropbox",
  },
  {
    name: "Google",
    description: "Upload your file using Google.",
    url: "https://forms.gle/v6W7co2ZcEgZpv376",
    logo: "https://thumb.wikimedia.org/wikipedia/commons/thumb/1/12/Google_Drive_icon_%282020%29.svg/960px-Google_Drive_icon_%282020%29.svg.png",
    className: "google",
  },
  {
    name: "Microsoft SharePoint",
    description: "Upload your file using Microsoft SharePoint.",
    url: "https://mooroolbarkcollege-my.sharepoint.com/:f:/g/personal/har0208_mooroolbarkcollege_vic_edu_au/IgCYHmZxyf3qS6Uw1Qa0L1HAATpwzqNiiKV3F-jTLwNpNLM",
    logo: "https://thumb.wikimedia.org/wikipedia/commons/thumb/e/ec/Microsoft_Office_SharePoint_%282019–2025%29.svg/1280px-Microsoft_Office_SharePoint_%282019–2025%29.svg.png",
    className: "sharepoint",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="description"
      content="Send a file to Nix Hartogh."
    />

    <title>Send a File to Nix Hartogh</title>

    <style>
      :root {
        font-family:
          Inter,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          Roboto,
          Helvetica,
          Arial,
          sans-serif;

        --background: #f5f5f7;
        --card: rgba(255, 255, 255, 0.84);
        --card-hover: rgba(255, 255, 255, 0.98);

        --text: #1d1d1f;
        --muted: #6e6e73;
        --border: rgba(0, 0, 0, 0.09);

        --shadow: rgba(0, 0, 0, 0.08);
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --background: #0c0c0e;
          --card: rgba(29, 29, 31, 0.82);
          --card-hover: rgba(40, 40, 43, 0.96);

          --text: #f5f5f7;
          --muted: #a1a1a6;
          --border: rgba(255, 255, 255, 0.1);

          --shadow: rgba(0, 0, 0, 0.4);
        }
      }

      * {
        box-sizing: border-box;
      }

      html {
        min-height: 100%;
      }

      body {
        margin: 0;

        min-height: 100vh;

        display: flex;
        align-items: center;
        justify-content: center;

        padding: 40px 20px;

        background:
          radial-gradient(
            circle at 50% -20%,
            rgba(0, 113, 227, 0.13),
            transparent 45%
          ),
          var(--background);

        color: var(--text);
      }

      main {
        width: 100%;
        max-width: 720px;
      }

      /* --------------------
         HEADER
      -------------------- */

      header {
        text-align: center;
        margin-bottom: 38px;
      }

      h1 {
        margin: 0 0 14px;

        font-size: clamp(2rem, 7vw, 3.3rem);
        line-height: 1.05;

        letter-spacing: -0.045em;
      }

      .subtitle {
        margin: 0 auto;

        max-width: 520px;

        color: var(--muted);

        font-size: 1.05rem;
        line-height: 1.55;
      }

      /* --------------------
         UPLOAD OPTIONS
      -------------------- */

      .options {
        display: grid;
        gap: 15px;
      }

      .option {
        position: relative;

        display: flex;
        align-items: center;

        gap: 20px;

        padding: 20px;

        color: inherit;
        text-decoration: none;

        background: var(--card);

        border: 1px solid var(--border);
        border-radius: 22px;

        backdrop-filter: blur(25px);
        -webkit-backdrop-filter: blur(25px);

        box-shadow:
          0 8px 30px var(--shadow);

        transition:
          transform 0.2s ease,
          background 0.2s ease,
          box-shadow 0.2s ease;
      }

      .option:hover {
        transform: translateY(-3px);

        background: var(--card-hover);

        box-shadow:
          0 14px 35px var(--shadow);
      }

      .option:active {
        transform: scale(0.99);
      }

      .option:focus-visible {
        outline: 3px solid #007aff;
        outline-offset: 4px;
      }

      /* --------------------
         LOGO
      -------------------- */

      .logo-container {
        flex-shrink: 0;

        display: flex;
        align-items: center;
        justify-content: center;

        width: 64px;
        height: 64px;

        border-radius: 17px;

        background: white;
      }

      .logo-container img {
        width: 36px;
        height: 36px;

        object-fit: contain;
      }

      .google .logo-container img {
        width: 34px;
        height: 34px;
      }

      .sharepoint .logo-container img {
        width: 38px;
        height: 38px;
      }

      /* --------------------
         TEXT
      -------------------- */

      .option-content {
        flex: 1;
        min-width: 0;
      }

      .option-name {
        display: block;

        margin-bottom: 5px;

        font-size: 1.14rem;
        font-weight: 650;

        letter-spacing: -0.01em;
      }

      .option-description {
        display: block;

        color: var(--muted);

        font-size: 0.93rem;
        line-height: 1.4;
      }

      /* --------------------
         ARROW
      -------------------- */

      .arrow {
        flex-shrink: 0;

        width: 34px;
        height: 34px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 50%;

        color: var(--muted);

        font-size: 1.5rem;

        transition:
          transform 0.2s ease,
          background 0.2s ease;
      }

      .option:hover .arrow {
        transform: translateX(3px);

        background: rgba(128, 128, 128, 0.12);
      }

      /* --------------------
         FOOTER
      -------------------- */

      .notice {
        margin-top: 28px;

        text-align: center;

        color: var(--muted);

        font-size: 0.84rem;
        line-height: 1.5;
      }

      /* --------------------
         MOBILE
      -------------------- */

      @media (max-width: 520px) {
        body {
          padding: 28px 14px;
        }

        header {
          margin-bottom: 28px;
        }

        .option {
          gap: 15px;

          padding: 17px;

          border-radius: 18px;
        }

        .logo-container {
          width: 52px;
          height: 52px;

          border-radius: 14px;
        }

        .logo-container img {
          width: 30px;
          height: 30px;
        }

        .sharepoint .logo-container img {
          width: 32px;
          height: 32px;
        }

        .option-name {
          font-size: 1.05rem;
        }

        .option-description {
          font-size: 0.86rem;
        }

        .arrow {
          width: 28px;
          height: 28px;
        }
      }
    </style>
  </head>

  <body>
    <main>
      <header>
        <h1>Send a File to Nix Hartogh</h1>

        <p class="subtitle">
          Choose a service below to securely send me a file.
        </p>
      </header>

      <div class="options">
        {
          uploadOptions.map((option) => (
            <a
              class={`option ${option.className}`}
              href={option.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              <div class="logo-container">
                <img
                  src={option.logo}
                  alt={`${option.name} logo`}
                  loading="eager"
                />
              </div>

              <div class="option-content">
                <span class="option-name">
                  {option.name}
                </span>

                <span class="option-description">
                  {option.description}
                </span>
              </div>

              <span
                class="arrow"
                aria-hidden="true"
              >
                ›
              </span>
            </a>
          ))
        }
      </div>

<div class="privacy-note">
  <strong>Want this file to stay between us?</strong>
  <span>
    Encrypt it with my
    <a
      href="https://nixie.online/pgp"
      target="_blank"
      rel="noopener noreferrer"
    >
      PGP key
    </a>
    before uploading.
  </span>
</div>

      <p class="notice">
        Select whichever service is most convenient for you.
        You only need to upload your file once.
      </p>
    </main>
  </body>
</html>
